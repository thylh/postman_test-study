{
  "info": {
    "_postman_id": "8e9d7f0e-6b75-4c83-9cfb-pokeapi-test",
    "name": "PokeAPI - Postman API Testing",
    "description": "Bộ kiểm thử API PokeAPI v2 phục vụ bài tập kiểm thử bằng Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://pokeapi.co/api/v2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - List Pokémon - Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pokemon?limit=10&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemon"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        },
        "description": "Kiểm tra danh sách Pokémon và phân trang."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('count is a number', function () { pm.expect(data.count).to.be.a('number'); });",
              "pm.test('results is an array', function () { pm.expect(data.results).to.be.an('array'); });",
              "pm.test('Returns 10 results', function () { pm.expect(data.results).to.have.lengthOf(10); });",
              "pm.test('Each result has name and url', function () {",
              "    data.results.forEach(item => {",
              "        pm.expect(item).to.have.property('name');",
              "        pm.expect(item).to.have.property('url');",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get Pokémon by ID - Pikachu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pokemon/25/",

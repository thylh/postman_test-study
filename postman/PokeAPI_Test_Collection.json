        },
        "description": "Kiểm tra lấy Pokémon theo ID."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('ID is 25', function () { pm.expect(data.id).to.eql(25); });",
              "pm.test('Name is pikachu', function () { pm.expect(data.name).to.eql('pikachu'); });",
              "pm.test('Has types array', function () { pm.expect(data.types).to.be.an('array').and.not.empty; });",
              "pm.test('Has sprites object', function () { pm.expect(data.sprites).to.be.an('object'); });"
            ]
          }
        }

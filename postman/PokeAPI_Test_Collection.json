    {
      "name": "06 - Pagination - Offset 20",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pokemon?limit=20&offset=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemon"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "offset",
              "value": "20"
            }
          ]
        },
        "description": "Kiểm tra phân trang với offset khác 0."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('results contains at most 20 items', function () { pm.expect(data.results.length).to.be.at.most(20); });",
              "pm.test('next is string or null', function () { pm.expect(data.next === null || typeof data.next === 'string').to.eql(true); });",
              "pm.test('previous is string or null', function () { pm.expect(data.previous === null || typeof data.previous === 'string').to.eql(true); });",
              "pm.test('Second page is different from first item', function () { pm.expect(data.results[0].name).to.not.eql('bulbasaur'); });"
            ]
          }
        }
      ]
    },
